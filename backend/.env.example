PORT=5000
# The schema is managed with Prisma Migrate (see docs/TECHNICAL.md, section 7). With Neon use
# the direct connection string (host without "-pooler"): migrations don't work through the pooler.
DATABASE_URL="postgresql://postgres:password123@localhost:5432/medcita?schema=public"
# Generate a real one, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start with this example value or with the var unset.
JWT_SECRET=replace_me_with_a_generated_secret

# Frontend origin(s) allowed by CORS. Comma-separate multiple origins.
FRONTEND_URL=http://localhost:5173

# Clinic UTC offset in minutes, used to read appointment date/time (stored as
# local text) in the 24h reminder cron. Optional, defaults to -300 (Ecuador, UTC-5).
# CLINIC_UTC_OFFSET_MINUTES=-300

# WhatsApp — Meta Cloud API (preferred). If both token and phone number id are set it is
# used before Twilio, and confirmations/reminders go out as approved templates (docs/DEPLOY.md,
# section 7). Leave them commented out locally: a placeholder value counts as "configured"
# and every send would fail. Check a real setup with: npm run whatsapp:test -- +593999999999
# META_WHATSAPP_TOKEN=your_permanent_system_user_token
# META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id        # the "Phone number ID", not the phone number
# META_WHATSAPP_TEMPLATE_CONFIRMATION=cita_confirmada       # optional, name of the approved template
# META_WHATSAPP_TEMPLATE_REMINDER=recordatorio_cita         # optional
# META_WHATSAPP_TEMPLATE_LANGUAGE=es                        # optional, language code of both templates
# META_GRAPH_VERSION=v21.0   # optional, defaults to v21.0

# WhatsApp — Twilio (fallback if Meta vars are not set)
# TWILIO_ACCOUNT_SID=your_sid_here
# TWILIO_AUTH_TOKEN=your_token_here
# TWILIO_WHATSAPP_NUMBER=your_twilio_number_here

# Email — Brevo (account set up in S3-06; wired into emailService.js in S3-07)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_verified_sender@example.com

# Email — SendGrid (legacy, free-tier credits exhausted, kept for reference)
SENDGRID_API_KEY=your_key_here
# SENDGRID_FROM_EMAIL=your_verified_sender@example.com   # optional, defaults to no-reply@medcita.ec

# Private file storage (S8-06): any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# The bucket must be private: the app only hands out short-lived signed URLs.
# Verify it with `npm run storage:check`. Nothing in the app uploads files yet.
# S3_BUCKET=medcita-files
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_REGION=us-east-1                       # Cloudflare R2: auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # leave unset for AWS S3
# S3_FORCE_PATH_STYLE=true                  # MinIO and some providers
# S3_URL_TTL_SECONDS=300                    # signed URL lifetime (max 900)

# Dedicated database for `npm test`. Its name MUST end with _test: the suite wipes
# every table between tests and refuses to run against anything else.
# TEST_DATABASE_URL="postgresql://postgres:password123@localhost:5432/medcita_test?schema=public"

# Number of reverse proxies in front of the app, used to read the real client IP
# for the login rate limits. Leave it unset locally (no proxy) and on Render, where it
# defaults to 2 (Cloudflare + Render's load balancer). Never "true": it lets clients
# spoof their IP. Verify with GET /api/admin/client-ip (admin only).
# TRUST_PROXY=2

# Dev only: print the emailed links (password reset, sign-up confirmation, invitations)
# in the console (handy with no email provider). NEVER enable it in production: a link
# in the logs is a valid credential until it expires.
# LOG_PASSWORD_RESET_LINKS=true

# Local QA only: also return the sign-up confirmation and invitation links in the API
# response (`devLink`), so a script (Postman/newman) can finish them without a mailbox.
# The server refuses to start with it when NODE_ENV=production or on Render.
# EXPOSE_ACCOUNT_LINKS=true
