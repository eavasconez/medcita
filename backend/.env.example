PORT=5000
DATABASE_URL="postgresql://postgres:password123@localhost:5432/medcita?schema=public"
# Generate a real one, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start with this example value or with the var unset.
JWT_SECRET=replace_me_with_a_generated_secret

# Frontend origin(s) allowed by CORS. Comma-separate multiple origins.
FRONTEND_URL=http://localhost:5173

# WhatsApp — Meta Cloud API (preferred). If set, used before Twilio.
META_WHATSAPP_TOKEN=your_meta_access_token_here
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# META_GRAPH_VERSION=v21.0   # optional, defaults to v21.0

# WhatsApp — Twilio (fallback if Meta vars are not set)
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_WHATSAPP_NUMBER=your_twilio_number_here

# Email — Brevo (account set up in S3-06; wired into emailService.js in S3-07)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_verified_sender@example.com

# Email — SendGrid (legacy, free-tier credits exhausted, kept for reference)
SENDGRID_API_KEY=your_key_here
# SENDGRID_FROM_EMAIL=your_verified_sender@example.com   # optional, defaults to no-reply@medcita.ec
