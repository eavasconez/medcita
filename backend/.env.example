PORT=5000
DATABASE_URL="postgresql://postgres:password123@localhost:5432/medcita?schema=public"
JWT_SECRET=demo_secret_key_123

# WhatsApp — Meta Cloud API (preferred). If set, used before Twilio.
META_WHATSAPP_TOKEN=your_meta_access_token_here
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# META_GRAPH_VERSION=v21.0   # optional, defaults to v21.0

# WhatsApp — Twilio (fallback if Meta vars are not set)
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_WHATSAPP_NUMBER=your_twilio_number_here

# Email (Demo Stub)
SENDGRID_API_KEY=your_key_here
