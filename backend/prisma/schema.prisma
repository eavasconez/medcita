generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A consultorio: the unit that owns every other record. Staff only ever see the
// patients, appointments and schedules of their own clinic.
model Clinic {
  id        String   @id @default(uuid())
  name      String
  // URL-safe name, unique across the platform
  slug      String   @unique
  // IANA zone of the clinic. Appointment date/time are clinic-local text; this zone
  // says which real instant they are (utils/clinicTime.js).
  timezone  String   @default("America/Guayaquil")
  createdAt DateTime @default(now())

  // Where the clinic is, for the reminders ("Dirección")
  address   String?
  // Appointment reminders (S9-03). The defaults are what every clinic did before they were
  // configurable: one WhatsApp and one email, 24 hours before.
  reminderEnabled     Boolean @default(true)
  // Hours before the appointment of the first and, optionally, a second reminder
  reminderHours       Int     @default(24)
  secondReminderHours Int?
  reminderWhatsapp    Boolean @default(true)
  reminderEmail       Boolean @default(true)
  // Free text added to the reminders ("Llegar 10 minutos antes y traer la cédula")
  reminderIndications String?

  doctors        Doctor[]
  patients       Patient[]
  appointments   Appointment[]
  availabilities Availability[]
  invitations    Invitation[]
  consents       PatientConsent[]
  allergies      PatientAllergy[]
  medications    PatientMedication[]
  backgrounds    PatientBackground[]
  consultationNotes ConsultationNote[]
  consultationAddenda ConsultationAddendum[]
  consultationDiagnoses ConsultationDiagnosis[]
  patientVitals  PatientVitals[]
  appointmentTypes AppointmentType[]
  scheduleBlocks ScheduleBlock[]
}

model Doctor {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  password            String
  createdAt           DateTime             @default(now())
  role                String               @default("doctor")
  specialty           String?
  bio                 String?
  address             String?
  // When the password last changed; tokens issued before it stop working
  passwordChangedAt   DateTime?
  clinicId            String
  clinic              Clinic               @relation(fields: [clinicId], references: [id])
  appointments        Appointment[]
  availabilities      Availability[]
  passwordResetTokens PasswordResetToken[]
  scheduleBlocks      ScheduleBlock[]

  // Lets Appointment and Availability point at a doctor *of the same clinic*
  @@unique([id, clinicId])
  @@index([clinicId])
}

model Patient {
  id           String        @id @default(uuid())
  name         String
  phone        String
  email        String?
  createdAt    DateTime      @default(now())
  cedula       String?

  // The patient's record (S10-02). All optional: a patient booked by phone has none of it.
  // Demographic and administrative data, not clinical: the front desk fills it in too.
  // Birth date is clinic-local text ("2015-03-09", like Appointment.date); the age is derived.
  birthDate            String?
  // female | male | other
  sex                  String?
  address              String?
  occupation           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  insuranceProvider    String?
  insuranceNumber      String?
  // Legal representative, for patients under 18
  guardianName         String?
  guardianCedula       String?
  guardianPhone        String?
  guardianRelationship String?

  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]
  consents     PatientConsent[]
  allergies    PatientAllergy[]
  medications  PatientMedication[]
  backgrounds  PatientBackground[]
  notes        ConsultationNote[]
  diagnoses    ConsultationDiagnosis[]
  vitals       PatientVitals[]

  // A phone or a cedula identifies a patient inside one clinic, not across clinics
  @@unique([clinicId, phone])
  @@unique([clinicId, cedula])
  // Lets Appointment point at a patient *of the same clinic*
  @@unique([id, clinicId])
}

model Availability {
  id        String @id @default(uuid())
  dayOfWeek Int
  startTime String
  endTime   String
  doctorId  String
  clinicId  String
  clinic    Clinic @relation(fields: [clinicId], references: [id])
  // The doctor must belong to the same clinic as the schedule
  doctor    Doctor @relation(fields: [doctorId, clinicId], references: [id, clinicId])

  @@unique([doctorId, dayOfWeek, startTime])
}

model Appointment {
  id             String    @id @default(uuid())
  date           String
  time           String
  status         String    @default("pending_approval")
  notes          String?
  doctorId       String
  patientId      String
  createdAt      DateTime  @default(now())
  // Set when the 24h reminder is claimed/sent; null means it is still owed.
  reminderSentAt DateTime?
  // The same for the second reminder, when the clinic sends one. A second reminder that was
  // no longer owed (the first one already went out inside its window) is dated too.
  secondReminderSentAt DateTime?
  // How long the visit lasts, copied from its type when it is booked: editing the
  // type later does not move or overlap the appointments already in the agenda.
  durationMinutes Int      @default(30)
  clinicId       String
  clinic         Clinic    @relation(fields: [clinicId], references: [id])
  // The doctor and the patient must belong to the same clinic as the appointment
  doctor         Doctor    @relation(fields: [doctorId, clinicId], references: [id, clinicId])
  patient        Patient   @relation(fields: [patientId, clinicId], references: [id, clinicId])
  // The kind of visit. Optional in the database on purpose: code from before the types
  // existed can still book (an appointment without a type counts as the clinic's default
  // type), so going back to an older release never breaks booking. The app always sets it.
  typeId         String?
  type           AppointmentType? @relation(fields: [typeId, clinicId], references: [id, clinicId], onDelete: Restrict)
  consultationNote ConsultationNote?
  vitals         PatientVitals[]

  @@index([clinicId, date])
}

// A kind of visit a clinic offers ("First visit, 40 min", "Check-up, 20 min"): its
// length decides how much of the agenda a booking takes. Every clinic has exactly one
// default type of 30 minutes (what every appointment was before types existed). A type
// is archived (`active = false`), never deleted, so past appointments keep theirs.
model AppointmentType {
  id              String        @id @default(uuid())
  name            String
  durationMinutes Int
  // '#rrggbb', used to paint the type in the calendar
  color           String
  isDefault       Boolean       @default(false)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  clinicId        String
  clinic          Clinic        @relation(fields: [clinicId], references: [id])
  appointments    Appointment[]

  @@unique([clinicId, name])
  // Lets Appointment point at a type *of the same clinic*
  @@unique([id, clinicId])
}

// Days a doctor, or the whole clinic, does not attend: holidays, vacations, a congress.
// Whole days only, `startDate` to `endDate` both included ('YYYY-MM-DD', clinic-local like
// Appointment.date). Nobody can book on a blocked day; appointments already there stay and
// are listed so they can be rescheduled. `doctorId` null means every doctor of the clinic.
model ScheduleBlock {
  id        String   @id @default(uuid())
  startDate String
  endDate   String
  reason    String
  createdAt DateTime @default(now())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  doctorId  String?
  // The doctor must belong to the same clinic as the block; deleting the doctor deletes it
  doctor    Doctor?  @relation(fields: [doctorId, clinicId], references: [id, clinicId], onDelete: Cascade)

  @@index([clinicId, startDate, endDate])
}

// How many times a client hit a rate limit (failed logins, password resets, sign-ups...)
// inside its current window (S9-08). It lives in the database so the counts survive a deploy
// and are shared by every instance of the backend. `key` is "<limiter>:<sha256 of the client>"
// (the client is an email or an IP, which are not kept in the clear); a row is dead once
// `resetAt` has passed and a cleanup removes it.
model RateLimitCounter {
  key     String   @id
  hits    Int
  resetAt DateTime

  @@index([resetAt])
}

// One-time password reset links. Only the SHA-256 hash of the token is stored, so
// a database leak does not expose usable links. A link is deleted when it is used.
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

// What an admin or a secretary did with appointments, patients and accounts.
// Append-only: nothing updates or deletes these rows. There are no foreign keys on
// purpose, so a record outlives the account or the data it talks about. `changes`
// lists the fields that changed, with before/after values only for the ones that
// are safe to keep (never contact data, notes or passwords).
model AuditLog {
  id        String   @id @default(uuid())
  // Insert order. createdAt cannot tell apart the entries of one transaction: the
  // database stamps all of them with the moment the transaction started.
  seq       Int      @default(autoincrement())
  createdAt DateTime @default(now())
  actorId   String
  actorName String
  actorRole String
  action    String
  entity    String
  entityId  String
  doctorId  String?
  // The clinic the actor belongs to. Entries keep no foreign key, like actorId.
  clinicId  String
  changes   Json?
  // Where the request came from (the client IP and its User-Agent, shortened)
  ip        String?
  userAgent String?

  @@index([clinicId, createdAt, seq])
  @@index([createdAt, seq])
  @@index([actorId])
  @@index([entity, entityId])
}

// A sign-up waiting for its email to be confirmed. Nothing exists yet (no clinic,
// no account): both are created when the link is used. Only the SHA-256 hash of
// the link's token is stored, and the password only as a bcrypt hash.
model SignupRequest {
  id           String   @id @default(uuid())
  tokenHash    String   @unique
  name         String
  email        String
  clinicName   String
  passwordHash String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email])
}

// A person an admin invited to join a clinic, until they accept: the account does
// not exist yet (they choose their own password with the emailed link). One pending
// invitation per email and clinic; inviting again replaces its link. Only the
// SHA-256 hash of the token is stored. The inviter is kept by id and name, without a
// foreign key, so the invitation outlives them.
model Invitation {
  id            String   @id @default(uuid())
  tokenHash     String   @unique
  name          String
  email         String
  role          String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  invitedById   String
  invitedByName String
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, email])
}

// One row per message MedCita tried to send (WhatsApp or email): whether it went
// out, through which provider, and why not when it failed. It never keeps the text
// of the message or the full address: only a masked destination, enough to tell
// recipients apart. Like AuditLog it has no foreign keys, so it outlives what it
// refers to. `clinicId` is empty for messages sent before a clinic exists (the
// sign-up confirmation).
model NotificationLog {
  id                String   @id @default(uuid())
  createdAt         DateTime @default(now())
  clinicId          String?
  appointmentId     String?
  // appointment_confirmation, appointment_reminder, appointment_second_reminder,
  // doctor_new_appointment, password_reset, signup_confirmation, account_exists, invitation;
  // and what the patient did with the buttons of the WhatsApp reminder (S9-02):
  // patient_confirmed, patient_cancelled, patient_reschedule_request, patient_reply_ignored
  // (received), patient_reply_answer (our answer), reschedule_request_notice (email to staff)
  kind              String
  channel           String
  provider          String
  // patient, doctor or user: who the message was for
  recipient         String
  // sent, failed, or simulated (no provider is configured: nothing really left);
  // received: a message that came IN from the patient (S9-02), not one we sent
  status            String
  errorCode         String?
  error             String?
  providerMessageId String?
  // "+593***042" or "ma***@gmail.com"
  destination       String

  @@index([clinicId, createdAt])
  @@index([appointmentId, createdAt])
}

// What the patient agreed to about their health data, as an append-only list of events:
// a consent given and, later, withdrawn is two rows, never an edit. `documentVersion` says
// which text the patient was shown (see legal/healthDataConsent.js), so a change in the
// wording is visible: whoever agreed to an older version is shown as out of date. The
// person who recorded it is kept as plain text (not a link) so the record outlives the
// account. No free-text note on purpose: it would end up holding health data.
model PatientConsent {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  clinicId        String
  patientId       String
  // true = consent given, false = consent withdrawn
  granted         Boolean
  documentVersion String
  // in_person_signed, in_person_verbal, electronic or other
  method          String
  recordedById    String
  recordedByName  String
  recordedByRole  String
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  // The patient must belong to the same clinic as the consent. A patient created by mistake
  // can still be deleted: its consents go with it.
  patient         Patient  @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([clinicId, createdAt])
}

// What a doctor must know before treating a patient (S10-03). Clinical data: read and written
// only by the roles of middleware/clinicalAccess.js, every read and change audited. The
// patient must belong to the same clinic as the row. `onDelete: Restrict` on purpose: a
// patient with clinical data is never deleted as a "record created by mistake", because
// those rows would vanish with nobody having looked at them.

// A substance the patient reacts to. Resolved allergies stay (active = false), they are
// not erased: what a patient once reacted to is part of the history.
model PatientAllergy {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinicId  String
  patientId String
  substance String
  reaction  String?
  // mild | moderate | severe
  severity  String?
  active    Boolean  @default(true)
  // Who recorded it, as plain text so the row outlives the account
  recordedById   String
  recordedByName String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  patient   Patient  @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([patientId, active])
}

// A medicine the patient takes regularly. Stopped ones stay (active = false).
model PatientMedication {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinicId  String
  patientId String
  name      String
  dose      String?
  frequency String?
  active    Boolean  @default(true)
  recordedById   String
  recordedByName String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  patient   Patient  @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([patientId, active])
}

// One line of the patient's history: personal, family, surgical or a habit.
model PatientBackground {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinicId    String
  patientId   String
  // personal | family | surgical | habit
  category    String
  description String
  // When, in the doctor's words ("2019", "since childhood"); free text on purpose
  noted       String?
  recordedById   String
  recordedByName String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  patient     Patient  @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@index([patientId, category])
}

// The doctor's record of one consultation, in the four parts of a SOAP note (S10-04):
// Subjective (what the patient says), Objective (what is observed and measured), Assessment
// and Plan. One note per appointment. It starts as a draft that its author edits (the screen
// saves it as they type) and is closed once: a closed note is never edited again, a correction
// is an addendum with its own date and author, so what the chart said on a given day can be
// trusted. Clinical data: same access rule and audit as the rest (middleware/clinicalAccess.js).
// RESTRICT everywhere on purpose: a patient, or an appointment, with a note is not deleted.
model ConsultationNote {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  clinicId      String
  patientId     String
  appointmentId String    @unique
  // draft | closed
  status        String    @default("draft")
  // Counts the saves of the draft. A save that carries an older number is refused (409), so
  // two open screens cannot silently overwrite each other.
  revision      Int       @default(1)
  subjective    String    @default("")
  objective     String    @default("")
  assessment    String    @default("")
  plan          String    @default("")
  // The template it was started from (general | pediatrics | blank); only informative
  template      String?
  // Who wrote it and who closed it, as plain text so the note outlives the account
  authorId      String
  authorName    String
  closedAt      DateTime?
  closedById    String?
  closedByName  String?
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  patient       Patient   @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  addenda       ConsultationAddendum[]
  diagnoses     ConsultationDiagnosis[]

  @@index([patientId, createdAt])
  @@index([clinicId, status])
}

// A correction or an addition to a closed note. Append-only: never edited, never deleted.
model ConsultationAddendum {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  clinicId   String
  noteId     String
  text       String
  authorId   String
  authorName String
  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  note       ConsultationNote @relation(fields: [noteId], references: [id], onDelete: Restrict)

  @@index([noteId, createdAt])
}

// The ICD-10 (CIE-10) list the doctor picks diagnoses from (S10-05). One list for the whole
// platform, not per clinic, and not data of any patient. MedCita does not ship it: it is loaded
// with `npm run diagnoses:import` from a file (see docs/TECHNICAL.md for where it comes from and
// the licence caveat), so the repository stays free of the classification itself.
model DiagnosisCode {
  id         String  @id @default(uuid())
  // 'A00.0': the code with the point after the third character, as doctors write it
  code       String  @unique
  // 'A000': the same without the point, uppercase, for searching by code
  codeKey    String
  name       String
  // The name lowercased and without accents, for searching by name
  searchText String
  // category (three characters, A00) or subcategory (four or more, A00.0)
  level      String
  // Whether a diagnosis can be recorded with it. A category that is split into subcategories
  // (A00 into A00.0, A00.1...) is a heading, not a diagnosis.
  selectable Boolean @default(true)
  // Where the row was loaded from (e.g. msp-rdacaa) and the revision of the classification
  source     String
  version    String  @default("CIE10")

  @@index([codeKey])
  @@index([source])
}

// A diagnosis of a consultation note. The code and the name are COPIED from the catalogue (there
// is no link to it) so a note keeps saying what it said when it was written, whatever happens
// to the catalogue later. `code` is empty for a diagnosis typed as free text (a diagnosis that
// is not in the list, or a clinic that has not loaded it). Only a draft note can change its
// diagnoses: once it is closed they are as final as the rest of the note.
model ConsultationDiagnosis {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  clinicId   String
  patientId  String
  noteId     String
  code       String?
  name       String
  // primary | secondary. A note has at most one primary diagnosis.
  kind       String   @default("secondary")
  // presumptive | definitive
  certainty  String   @default("presumptive")
  recordedById   String
  recordedByName String
  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  patient    Patient  @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  note       ConsultationNote @relation(fields: [noteId], references: [id], onDelete: Restrict)

  // The same code twice in one note makes no sense (free-text rows have no code and may repeat)
  @@unique([noteId, code])
  @@index([patientId, createdAt])
  @@index([code])
}

// One set of measurements taken on a patient (S10-06): weight, height, blood pressure, heart and
// breathing rate, temperature and oxygen saturation. Any of them may be missing, never all. The
// body mass index is not stored: it is worked out from the weight and the height of the same
// reading. Clinical data (same access rule and audit as the rest). A reading is never edited:
// one taken by mistake is voided (`voidedAt`), which keeps it in the history but takes it out of
// the charts and the "latest" values. RESTRICT: a patient or an appointment with readings is not
// deleted. Metric units only.
model PatientVitals {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  clinicId       String
  patientId      String
  // The visit it was taken at, when it was taken at one
  appointmentId  String?
  // When it was measured (may be earlier than when it was typed in)
  measuredAt     DateTime
  weightKg       Float?
  heightCm       Float?
  // mmHg
  systolic       Int?
  diastolic      Int?
  // beats and breaths per minute
  heartRate      Int?
  respiratoryRate Int?
  temperatureC   Float?
  // percent
  oxygenSaturation Int?
  recordedById   String
  recordedByName String
  voidedAt       DateTime?
  voidedById     String?
  voidedByName   String?
  voidReason     String?
  clinic         Clinic    @relation(fields: [clinicId], references: [id])
  patient        Patient   @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([patientId, measuredAt])
  @@index([appointmentId])
}
