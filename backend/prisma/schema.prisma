generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Doctor {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  password       String
  createdAt      DateTime       @default(now())
  role           String         @default("doctor")
  specialty      String?
  bio            String?
  address        String?
  appointments   Appointment[]
  availabilities Availability[]
  passwordResetTokens PasswordResetToken[]
}

model Patient {
  id           String        @id @default(uuid())
  name         String
  phone        String        @unique
  email        String?
  createdAt    DateTime      @default(now())
  cedula       String?       @unique
  appointments Appointment[]
}

model Availability {
  id        String @id @default(uuid())
  dayOfWeek Int
  startTime String
  endTime   String
  doctorId  String
  doctor    Doctor @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, dayOfWeek, startTime])
}

model Appointment {
  id        String   @id @default(uuid())
  date      String
  time      String
  status    String   @default("pending_approval")
  notes     String?
  doctorId  String
  patientId String
  createdAt DateTime @default(now())
  // Set when the 24h reminder is claimed/sent; null means it is still owed.
  reminderSentAt DateTime?
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])
}

// One-time password reset links. Only the SHA-256 hash of the token is stored, so
// a database leak does not expose usable links. A link is deleted when it is used.
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}
