generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Doctor {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  password       String
  createdAt      DateTime       @default(now())
  role           String         @default("doctor")
  specialty      String?
  bio            String?
  address        String?
  // When the password last changed; tokens issued before it stop working
  passwordChangedAt DateTime?
  appointments   Appointment[]
  availabilities Availability[]
  passwordResetTokens PasswordResetToken[]
}

model Patient {
  id           String        @id @default(uuid())
  name         String
  phone        String        @unique
  email        String?
  createdAt    DateTime      @default(now())
  cedula       String?       @unique
  appointments Appointment[]
}

model Availability {
  id        String @id @default(uuid())
  dayOfWeek Int
  startTime String
  endTime   String
  doctorId  String
  doctor    Doctor @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, dayOfWeek, startTime])
}

model Appointment {
  id        String   @id @default(uuid())
  date      String
  time      String
  status    String   @default("pending_approval")
  notes     String?
  doctorId  String
  patientId String
  createdAt DateTime @default(now())
  // Set when the 24h reminder is claimed/sent; null means it is still owed.
  reminderSentAt DateTime?
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])
}

// One-time password reset links. Only the SHA-256 hash of the token is stored, so
// a database leak does not expose usable links. A link is deleted when it is used.
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

// What an admin or a secretary did with appointments, patients and accounts.
// Append-only: nothing updates or deletes these rows. There are no foreign keys on
// purpose, so a record outlives the account or the data it talks about. `changes`
// lists the fields that changed, with before/after values only for the ones that
// are safe to keep (never contact data, notes or passwords).
model AuditLog {
  id        String   @id @default(uuid())
  // Insert order. createdAt cannot tell apart the entries of one transaction: the
  // database stamps all of them with the moment the transaction started.
  seq       Int      @default(autoincrement())
  createdAt DateTime @default(now())
  actorId   String
  actorName String
  actorRole String
  action    String
  entity    String
  entityId  String
  doctorId  String?
  changes   Json?

  @@index([createdAt, seq])
  @@index([actorId])
  @@index([entity, entityId])
}
