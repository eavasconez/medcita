{
  "info": {
    "name": "MedCita API",
    "description": "Colección de pruebas por ticket. Cada carpeta corresponde a un ticket de Sprint 1 (S1-XX). Importar junto con el environment MedCita.postman_environment.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "S1-01 - Registro de médico",
      "item": [
        {
          "name": "Falla - nombre vacío",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"\",\n  \"password\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Mensaje de error correcto', () => pm.expect(pm.response.json().error).to.eql('Name is required'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Falla - email inválido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Doctor\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Mensaje de error correcto', () => pm.expect(pm.response.json().error).to.eql('A valid email is required'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Falla - password muy corto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Doctor\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Mensaje de error correcto', () => pm.expect(pm.response.json().error).to.eql('Password must be at least 6 characters'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Éxito - registro válido (normaliza espacios y mayúsculas)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Doctor\",\n  \"email\": \"  {{testEmailMixedCase}}  \",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const unique = `postman.s101.${Date.now()}@example.com`;",
                  "pm.collectionVariables.set('testEmail', unique);",
                  "pm.collectionVariables.set('testEmailMixedCase', unique.toUpperCase());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Devuelve token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "pm.test('Email normalizado en minúsculas y sin espacios', () => pm.expect(pm.response.json().user.email).to.eql(pm.variables.get('testEmail')));",
                  "pm.collectionVariables.set('lastToken', pm.response.json().token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Falla - email duplicado (case-insensitive)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Otro Doctor\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Mensaje de error correcto', () => pm.expect(pm.response.json().error).to.eql('Email already registered'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "S1-02 - Login de médico",
      "item": [
        {
          "name": "Falla - email/password vacíos",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"\",\n  \"password\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Mensaje de error correcto', () => pm.expect(pm.response.json().error).to.eql('Email and password are required'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Falla - usuario inexistente (mensaje genérico, sin enumeración)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no-existe-{{$randomInt}}@example.com\",\n  \"password\": \"cualquiera\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje genérico (no revela si el usuario existe)', () => pm.expect(pm.response.json().error).to.eql('Invalid credentials'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Falla - password incorrecto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje genérico', () => pm.expect(pm.response.json().error).to.eql('Invalid credentials'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Falla - password no-string",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": 123456\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 (no 500)', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Falla - email no-string",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": 123456,\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 (no 500)', () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Éxito - login válido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "const payload = JSON.parse(atob(pm.response.json().token.split('.')[1]));",
                  "pm.test('JWT expira en 24h (86400s)', () => pm.expect(payload.exp - payload.iat).to.eql(86400));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Éxito - login con espacios y mayúsculas en email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"  {{demoEmailMixedCase}}  \",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve el mismo usuario', () => pm.expect(pm.response.json().user.email).to.eql(pm.variables.get('demoEmail')));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "testEmail", "value": "postman.s101@example.com" },
    { "key": "testEmailMixedCase", "value": "Postman.S101@Example.com" },
    { "key": "lastToken", "value": "" },
    { "key": "demoEmail", "value": "demo@medcita.ec" },
    { "key": "demoEmailMixedCase", "value": "Demo@MedCita.EC" },
    { "key": "demoPassword", "value": "demo1234" }
  ]
}
